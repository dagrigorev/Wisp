# ════════════════════════════════════════════════════════════════════════════
#  Wisp — .gitignore
# ════════════════════════════════════════════════════════════════════════════

# ── CMake build directories ───────────────────────────────────────────────────
build/
build-*/
out/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
_deps/
install_manifest.txt
compile_commands.json

# ── MSVC / Visual Studio ──────────────────────────────────────────────────────
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk
*.obj
*.idb
*.ipdb
*.iobj
*.tlog
*.lastbuildstate
*.res
*.aps

# Visual Studio project/solution files (we use CMake, not VS projects)
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln
*.suo
*.user
*.userosscache
*.sln.docstates
.vs/

# Visual Studio Code
.vscode/
*.code-workspace

# ── Compiled / generated output ───────────────────────────────────────────────
*.o
*.a
*.so
*.dylib
*.map
*.pch
*.gch

# ── CPack / packaging ─────────────────────────────────────────────────────────
_CPack_Packages/
*.zip
*.tar.gz
*.7z
*.msi
*.nsis

# ── Runtime / user data ───────────────────────────────────────────────────────
# Do NOT commit user config or history — these live in %APPDATA% and %USERPROFILE%
*.wisp_history
Wisp.toml
.zshrc.local

# Wisp log files
*.wisp.log
wisp_debug.log

# ── Windows system junk ───────────────────────────────────────────────────────
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ── Clang tools ───────────────────────────────────────────────────────────────
.clangd/
.clang-tidy
.cache/

# ── Ninja ─────────────────────────────────────────────────────────────────────
.ninja_deps
.ninja_log

# ── Editor backup / swap files ────────────────────────────────────────────────
*~
*.bak
*.swp
*.swo
*.orig
\#*\#
.\#*

# ── Test artefacts ────────────────────────────────────────────────────────────
Testing/
CTestCostData.txt
LastTest.log
LastTestsFailed.log

# ── CI / toolchain caches ─────────────────────────────────────────────────────
.ccache/
vcpkg_installed/

.tmp-tools-smoke
.tmp-tools-unicode

# Agent local/runtime artifacts
.agent/tmp/
.agent/runs/
.agent/cache/

# Local model / tool noise
.ollama/
.open-code/
.opencodetmp/
.tmp-tools-unicode
.opencode/
.opencode-tmp/

# ── Large model files (do not commit) ─────────────────────────────────────────
models/phi-4/*.gguf
dist/models/phi-4/*.gguf
